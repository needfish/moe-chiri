---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead {title} {description} />
    </head>
    <body>
        <Header />
        <main class="page">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    @font-face {
        font-family: "Kitan Mono Term";
        src: url("./fonts/KitanMonoTerm-Regular.woff2");
        font-weight: regular;
    }
    body {
        background-color: #222;
        color: #ccc;
        max-width: 80ch;
        margin: 0 auto;
        padding: 1rem 1rem 1rem 1rem;
        font-family: "Kitan Mono Term";
        text-wrap: balanced;
        font-size: 16px;
    }
    a {
        color: #fa9442;
    }
</style>
