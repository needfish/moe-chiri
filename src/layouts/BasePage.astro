---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead {title} {description} />
    </head>
    <body>
        <div class="frost">
            <Header />
            <main class="page">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>

<style is:global>
    :root {
        --color: #fa9442;
        --page-width: 42rem;
    }
    @font-face {
      font-display: swap;
      font-family: 'Kitan Mono Term';
      font-style: normal;
      font-weight: 400;
      src: url('../fonts/kitan-mono-term-regular.ttf') format('truetype');
    }
    @font-face {
      font-display: swap;
      font-family: 'Kitan Mono Term';
      font-style: normal;
      font-weight: 700;
      src: url('../fonts/kitan-mono-term-bold.ttf') format('truetype');
    }
    body {
      margin: 0;
      background-image: url('/wallpaper-yellow.webp'),
        url('/wallpaper-green.webp'),
        url('/wallpaper-red-alt.webp'),
        url('/wallpaper-red.webp');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      color: #ccc;
      display: flex;
      flex-direction: column;
      min-height: 100svh;
      font-family: 'Kitan Mono Term', monospace;
      letter-spacing: -0.04em;
      text-wrap: balanced;
      font-size: 16px;
      line-height: 1.6;
    }
      body > * {
       width: 100%;
       max-width: var(--page-width);
       margin: 0 auto;
       box-sizing: border-box;
    }
    .frost {
       padding: 1rem 0;
       background: rgba(10, 10, 10, 0.75);
       -webkit-backdrop-filter: blur(28px) saturate(1.2);
       backdrop-filter: blur(28px) saturate(1.2);
       overflow: hidden;
    }
    .frost > * {
       width: 100%;
       max-width: none;
       padding-inline: 1rem;
       box-sizing: border-box;
    }
    main.page { flex: 1; }
    a {
        color: var(--color);
        text-decoration: none;
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-size: 16px;
    }
</style>
