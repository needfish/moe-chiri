---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead {title} {description} />
        <link rel="preload" href="/fonts/kitan-mono-term-regular.woff2" as="font" type="font/woff2" crossorigin>
    </head>
    <body>
        <div class="frost">
            <Header />
            <main class="page">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>

<style is:global>
  :root {
    --color: #fa9442;
    --page-width: 42rem;
  }

  @font-face {
    font-display: swap;
    font-family: 'Kitan Mono Term';
    font-weight: 400;
    src: url('/fonts/kitan-mono-term-regular.woff2') format('woff2');
  }
  @font-face {
    font-display: swap;
    font-family: 'Kitan Mono Term';
    font-weight: 700;
    src: url('/fonts/kitan-mono-term-bold.woff2') format('woff2');
  }

  html, body {
    margin: 0;
    display: flex;
    flex-direction: column;
    color: #ccc;
    font: 400 16px/1.6 'Kitan Mono Term', monospace;
    letter-spacing: -0.04em;
    text-wrap: balanced;
    overflow-x: clip;
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    background: url('/test-bg/gracile/gracile-earth-debris-field-5640x2400.webp') center / cover;
  }
  body > * {
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    box-sizing: border-box;
  }

  .frost {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem 0 5rem;
  }
  .frost::before {
    content: '';
    position: absolute;
    inset: 0 -8rem;
    background: rgba(10, 10, 10, 0.75);
    -webkit-backdrop-filter: blur(28px) saturate(1.2);
    backdrop-filter: blur(28px) saturate(1.2);
    -webkit-mask-image: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.16) 2rem, rgba(0, 0, 0, 0.5) 4rem, rgba(0, 0, 0, 0.84) 6rem, #000 8rem, #000 calc(100% - 8rem), rgba(0, 0, 0, 0.84) calc(100% - 6rem), rgba(0, 0, 0, 0.5) calc(100% - 4rem), rgba(0, 0, 0, 0.16) calc(100% - 2rem), transparent), linear-gradient(to top, transparent, #000 4rem);
    mask-image: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.16) 2rem, rgba(0, 0, 0, 0.5) 4rem, rgba(0, 0, 0, 0.84) 6rem, #000 8rem, #000 calc(100% - 8rem), rgba(0, 0, 0, 0.84) calc(100% - 6rem), rgba(0, 0, 0, 0.5) calc(100% - 4rem), rgba(0, 0, 0, 0.16) calc(100% - 2rem), transparent), linear-gradient(to top, transparent, #000 4rem);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    pointer-events: none;
  }
  .frost > * {
    position: relative;
    width: 100%;
    max-width: none;
    padding-inline: 1rem;
    box-sizing: border-box;
  }
  main.page { flex: 1; }

  a {
    color: var(--color);
    text-decoration: none;
  }
  h1, h2, h3, h4, h5, h6 {
    font-size: 16px;
  }
</style>
