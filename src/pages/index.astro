---
import { getCollection } from "astro:content";
import BasePage from "../layouts/BasePage.astro";
import { SITE_DESCRIPTION } from "../consts";
---

<BasePage title="kitan's space travel" description={SITE_DESCRIPTION}>
    <section class="bio">
        <p>Hi, I put my stuff here. Not much going on at the moment.</p>
    </section>
    <section class="section" id="links">
        <h2>Links</h2>
        <ul class="link-list">
            <li>
                <a href="https://bsky.app/profile/kitan.moe">[ Bluesky ]</a> - you can
                contact me here
            </li>
            <li><a href="https://github.com/needfish">[ GitHub ]</a></li>
            <li>
                <a href="https://kitan.moe/rss.xml">[ RSS ]</a> - Add to RSS feed
            </li>
        </ul>
    </section>
    <section class="section" id="colophon">
        <p>background from <a href="https://x.com/gracile_jp">@gracile_jp</a></p>
        <p>typeface is a custom build of <a href="https://typeof.net/Iosevka/">Iosevka</a></p>
    </section>
</BasePage>

<style>
    .link-list {
        list-style: none;
        padding: 0;
    }
</style>
