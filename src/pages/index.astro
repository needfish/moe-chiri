---
import { getCollection } from "astro:content";
import BasePage from "../layouts/BasePage.astro";
import { SITE_DESCRIPTION } from "../consts";
---

<BasePage title="kitan's space travel" description={SITE_DESCRIPTION}>
    <section class="bio">
        <p>Hi, I put my stuff here. Not much going on at the moment.</p>
    </section>
    <section class="section" id="links">
        <ul class="link-list">
            <li>
                <a href="https://bsky.app/profile/kitan.moe">[ bluesky ]</a> ← you can
                contact me here
            </li>
            <li><a href="https://github.com/needfish">[ github ]</a></li>
            <li>
                <button class="rss-copy" data-url="https://kitan.moe/rss.xml">[ rss ]</button> ← copy feed url
            </li>
        </ul>
    </section>
    <section class="section" id="colophon">
        <p>background from <a href="https://x.com/gracile_jp">@gracile_jp</a></p>
        <p>typeface is a custom build of <a href="https://typeof.net/Iosevka/">Iosevka</a></p>
    </section>
</BasePage>

<style>
    .link-list {
        list-style: none;
        padding: 0;
    }

    .rss-copy {
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        color: var(--color);
        cursor: pointer;
    }
</style>
<script>
    document.querySelectorAll(".rss-copy").forEach((el) => {
        el.addEventListener("click", async () => {
            await navigator.clipboard.writeText(el.dataset.url!);
            const old = el.textContent;
            el.textContent = "[ copied ]";
            setTimeout(() => (el.textContent = old), 1200);
        });
    });
</script>
