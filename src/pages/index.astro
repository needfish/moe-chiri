---
import BasePage from "../layouts/BasePage.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<BasePage title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="bio">
    <p>Hi, I put my stuff here. Not much going on at the moment.</p>
  </section>
  <section class="section" id="links">
    <ul class="link-list">
      <li>
        <a href="https://bsky.app/profile/kitan.moe">_bluesky</a>
        <span class="link-comment">// you can contact me here</span>
      </li>
      <li>
        <a href="https://github.com/needfish">_github</a>
      </li>
      <li>
        <button class="copy" data-copy="https://kitan.moe/rss.xml">
          _rss
        </button>{" "}
        <span class="link-comment">// copy feed url</span>
      </li>
      <li>
        <button class="copy" data-copy="curl kitan.moe">
          _curl
        </button>{" "}
        <span class="link-comment">// try curl on this site</span>
      </li>
    </ul>
  </section>
  <section class="section" id="colophon">
    <p>
      background: <a href="https://x.com/gracile_jp">@gracile_jp</a>
    </p>
    <p>
      typeface: custom build of{" "}
      <a href="https://typeof.net/Iosevka/">iosevka</a>
    </p>
    <p>
      site generator: <a href="https://astro.build">astro</a>, code assisted by
      LLMs
    </p>
  </section>
</BasePage>

<style>
  .link-list {
    list-style: none;
    padding: 0;
  }

  .copy {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color);
    cursor: pointer;
  }

  .link-comment {
    opacity: 0.55;
  }

  #colophon p {
    margin: 0;
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>(".copy").forEach((el) => {
    el.addEventListener("click", async () => {
      await navigator.clipboard.writeText(el.dataset.copy!);
      const old = el.textContent;
      el.textContent = "_copied";
      setTimeout(() => (el.textContent = old), 1200);
    });
  });
</script>
