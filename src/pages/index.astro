---
import { getCollection } from "astro:content";
import BasePage from "../layouts/BasePage.astro";
import MusicRow from "../components/MusicRow.astro";
import PostList from "../components/PostList.astro";
import { SITE_DESCRIPTION } from "../consts";

const musicEntries = (await getCollection("music")).slice(0, 3);
const posts = (await getCollection("blog"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 6);
---

<BasePage title="kitan's space travel" description={SITE_DESCRIPTION}>
    <section class="bio">
        <p>
            Hi, I put my stuff here. You can contact me on <a
                href="https://bsky.app/profile/kitan.moe">Bluesky</a
            >.
        </p>
        <p>
            Use <a href="https://kitan.moe/rss.xml ">this xml link</a> to add the
            blog to a RSS feed.
        </p>
    </section>

    {
        musicEntries.length > 0 && (
            <section class="section">
                <h2>Music</h2>
                <div class="music-list">
                    {musicEntries.map((entry) => (
                        <MusicRow
                            title={entry.data.title}
                            year={entry.data.year}
                            image={entry.data.image}
                            links={entry.data.links}
                        />
                    ))}
                </div>
                <p class="view-all">
                    <a href="/music">View all →</a>
                </p>
            </section>
        )
    }

    <section class="section" id="links">
        <h2>Links</h2>
        <ul class="link-list">
            <li>
                <a href="https://bsky.app/profile/kitan.moe">Bluesky</a> - you can
                contact me here
            </li>
            <li><a href="https://github.com/7kitan">GitHub</a></li>
            <li><a href="https://kitan.moe/rss.xml">RSS</a></li>
        </ul>
    </section>

    <section class="section" id="blog">
        <h2>Posts</h2>
        <PostList posts={posts} />
        <p class="view-all">
            <a href="/archive">View all →</a>
        </p>
    </section>
</BasePage>

<style>
    .bio p {
        margin: 0 0 0.75em;
    }
    .bio p:last-child {
        margin: 0;
    }
    .music-list {
        display: grid;
        gap: 0.5rem;
    }
    .section h2 {
        font-size: 18px;
        letter-spacing: normal;
        text-transform: none;
    }
    .link-list {
        list-style: none;
    }
    .view-all {
        font-family: var(--m);
        font-size: var(--fs-sm);
        margin-top: 0.5rem;
    }
</style>
