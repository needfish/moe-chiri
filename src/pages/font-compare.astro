---
import BasePage from "../layouts/BasePage.astro";
const samples = [
    { label: "Kitan Mono T (fallback Hiragino for JP)", css: "'Kitan Mono T', monospace" },
    { label: "IBM Plex Sans JP", css: "'IBM Plex Sans JP', monospace" },
    { label: "Noto Sans JP", css: "'Noto Sans JP', monospace" },
    { label: "Kitan Mono T + Plex fallback", css: "'Kitan Mono T', 'IBM Plex Sans JP', monospace" },
    { label: "Kitan Mono T + Noto fallback", css: "'Kitan Mono T', 'Noto Sans JP', monospace" },
];
const text = "気分次第です僕は　敵を選んで戦う少年 — Kitan Mono T 0123";
const kana = "かな カナ 漢字 魁星 踠いた 空へ舞う、闇を照らす。「」！？";
---
<BasePage title="Font comparison" description="JP font comparison: Kitan Mono T, IBM Plex Sans JP, Noto Sans JP">
    <h1>JP font comparison</h1>
    {samples.map((s) => (
        <section>
            <h2>{s.label}</h2>
            <p style={`font-family: ${s.css}`}>{text}</p>
            <p style={`font-family: ${s.css}`}>{kana}</p>
        </section>
    ))}
</BasePage>
<style>
    section { margin-block: 1.5rem; }
    h2 { color: var(--color); }
</style>
