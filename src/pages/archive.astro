---
import { getCollection } from "astro:content";
import BasePage from "../layouts/BasePage.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const groups: [string, typeof posts][] = [];
for (const post of posts) {
  const d = post.data.pubDate;
  const key =
    String(d.getFullYear()).slice(2) +
    "." +
    String(d.getMonth() + 1).padStart(2, "0") +
    ".";
  const last = groups.at(-1);
  if (last?.[0] === key) last[1].push(post);
  else groups.push([key, [post]]);
}
---

<BasePage title="archive">
  {groups.map(([heading, monthPosts]) => (
    <div class="archive-group">
      <h2 class="archive-heading">{heading}</h2>
      <ul class="archive-list">
        {monthPosts.map((post) => (
          <li>
            <span class="archive-date">
              {String(post.data.pubDate.getUTCDate()).padStart(2, "0")}
            </span>
            <a href={"/blog/" + post.id + "/"}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</BasePage>

<style>
  .archive-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .archive-group + .archive-group {
    margin-top: 1.5rem;
  }

  .archive-heading {
    font-weight: normal;
    margin-bottom: 0;
  }

  .archive-date {
    opacity: 0.55;
    margin-right: 1ch;
  }
</style>
