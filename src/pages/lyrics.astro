---
import BasePage from "../layouts/BasePage.astro";
import "../layouts/noto-jp.css";

type Line = { t: number; ja: string; en: string; interlude?: boolean };
const paras: Line[][] = [
  [
    { t: 1.1, ja: "気分次第です僕は　敵を選んで戦う少年", en: "It all depends on my mood, I'm a boy who chooses his enemies and fights" },
    { t: 5.5, ja: "叶えたい未来も無くて　夢に描かれるのを待ってた", en: "Without a future I want to fulfill, waiting for it to be drawn in my dreams" },
    { t: 10.7, ja: "そのくせ未来が怖くて　明日を嫌って過去に願って", en: "But I'm scared of the future, hating tomorrow and wishing for the past" },
    { t: 15.9, ja: "もう如何(どう)しようも無くなって叫ぶんだ", en: "I'm at a loss and I scream" },
    { t: 18.9, ja: "明日よ明日よもう来ないでよって", en: "Tomorrow! Tomorrow! Don't come anymore!" },
    { t: 21.7, ja: "そんな僕を置いて　月は沈み陽は昇る", en: "Leaving me like that, the moon sets and the sun rises" },
    { t: 26.6, ja: "けどその夜(よ)は違ったんだ　君は僕の手を", en: "But that night was different, you took my hand" },
    { t: 33.9, ja: "空へ舞う　世界の彼方　闇を照らす魁星(かいせい)", en: "Beyond the world dancing in the sky, illuminating the darkness" },
    { t: 40.2, ja: "「君と僕もさ、また明日へ向かっていこう」", en: "\"You and I, let's head towards tomorrow again\"" },
    { t: 44.2, ja: "夢で終わってしまうのならば　昨日を変えさせて", en: "If it's going to end in a dream, \"Let me change yesterday\"" },
    { t: 49.8, ja: "なんて言わないから　また明日も君とこうやって　笑わせて", en: "I won't say that, so let's laugh together like this tomorrow too" },
    { t: 56.8, ja: "♪ 間奏", en: "♪ Instrumental", interlude: true },
  ],
  [
    { t: 86.4, ja: "あれから世界は変わったって　本気で思ったって", en: "Since then, even if I seriously thought the world had changed" },
    { t: 91.2, ja: "期待したって変えようとしたって　未来は残酷で", en: "Even if I hoped and tried to change it, the future is cruel" },
    { t: 96.3, ja: "それでもいつだって君と見ていた　世界は本当に綺麗だった", en: "But the world we always watched together was truly beautiful" },
    { t: 102.7, ja: "忘れてないさ　思い出せるように仕舞ってるの", en: "I haven't forgotten, I keep it so I can remember" },
    { t: 106.9, ja: "君がいてもいなくても翔べるなんて妄想", en: "Whether you're here or not, the delusion that I can fly" },
    { t: 109.8, ja: "独りじゃ歩くことさえ僕はしないまま藍色の風に吐いた幻想", en: "Without walking alone, I entered a fantasy of indigo wind" },
    { t: 115.1, ja: "壊してくれって願って踠(もが)いたって", en: "Even if I wish for it to be destroyed and struggle" },
    { t: 120.2, ja: "願ったんなら叶えてしまえやって", en: "If I wished for it, you said to make it come true" },
    { t: 124, ja: "Eh…　君は言って", en: "Eh… you said" },
  ],
  [
    { t: 130.3, ja: "また明日の夜に　逢いに行こうと思うが", en: "I think I'll go see you again tomorrow night" },
    { t: 135.8, ja: "どうかな君はいないかな", en: "I wonder, are you not there?" },
    { t: 137.7, ja: "それでもいつまでも僕ら一つだから", en: "But we'll always be together" },
    { t: 140.8, ja: "またね　Sky Arrow　笑ってよう", en: "See you later, Sky Arrow, let's smile" },
    { t: 145.2, ja: "未来を少しでも君といたいから叫ぼう", en: "Let's shout because I want to be with you a little in the future" },
    { t: 148.5, ja: "今日の日をいつか思い出せ　未来の僕ら", en: "Remember this day someday, the future us" },
    { t: 152.3, ja: "♪ アウトロ", en: "♪ Outro", interlude: true },
  ],
];
---

<BasePage
  title="アスノヨゾラ哨戒班"
  description="Lyrics: Orangestar - Asu no Yozora Shoukaihan (Night Sky Patrol of Tomorrow)"
>
  <h1>アスノヨゾラ哨戒班</h1>
  <p>Orangestar feat. IA — Night Sky Patrol of Tomorrow</p>
  <iframe
    id="yt"
    src="https://www.youtube.com/embed/XogSflwXgpw?enablejsapi=1"
    title="アスノヨゾラ哨戒班"
    allow="autoplay; encrypted-media"
    allowfullscreen
  ></iframe>

  {paras.map((lines) => (
    <section lang="ja">
      {lines.map((line) => (
        <>
          {line.interlude
            ? <interlude class="l" data-t={line.t} set:html={line.ja} />
            : <span class="l" data-t={line.t} set:html={line.ja} />}
          <br />
          <span lang="en">{line.en}</span>
          <br />
        </>
      ))}
    </section>
  ))}
</BasePage>

<script>
  const tag = document.createElement("script");
  tag.src = "https://www.youtube.com/iframe_api";
  document.head.append(tag);
  let player: any;
  (window as any).onYouTubeIframeAPIReady = () => {
    player = new YT.Player("yt");
    const lines = [...document.querySelectorAll<HTMLElement>(".l")];
    setInterval(() => {
      if (!player.getCurrentTime) return;
      const t = player.getCurrentTime();
      let on: HTMLElement | undefined;
      for (const el of lines) if (Number(el.dataset.t) <= t) on = el;
      for (const el of lines) el.classList.toggle("on", el === on);
    }, 250);
  };
</script>

<style>
  iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }
  section {
    margin-block: 1.5rem;
  }
  span {
    color: #888;
  }
  .l {
    color: #ccc;
    transition: color 0.3s;
  }
  .l.on {
    color: var(--color);
  }
</style>
