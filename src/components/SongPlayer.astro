<div class="player" transition:persist="song-player">
    <div class="song">
        <span id="now-playing" hidden></span>
        <div class="pad">
            <button id="song-btn" aria-label="play song">
            <svg class="orbit" viewBox="0 0 100 100" fill="none" aria-hidden="true"><circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="3" stroke-dasharray="250 39" transform="rotate(118 50 50)"/></svg>
            <svg id="song-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
        </button>
        </div>
    </div>
    <div id="yt-player"></div>
</div>

<style>
    .song {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .pad {
        display: grid;
        place-items: center;
        width: 4em;
        aspect-ratio: 1;
    }

    #song-btn {
        position: relative;
        height: 3.2em;
        aspect-ratio: 1;
        border: none;
        background: none;
        color: inherit;
        cursor: pointer;
        padding: 0;
        display: grid;
        place-items: center;
    }

    #song-btn .orbit {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    #song-btn.playing .orbit {
        animation: spin 6s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(1turn);
        }
    }

    #song-icon {
        display: block;
        width: 40%;
        height: 40%;
    }

    #now-playing {
        min-width: 0;
        max-width: 24rem;
        overflow: hidden;
        text-align: right;
    }

    @media (max-width: 40rem) {
        .song {
            flex-direction: row-reverse;
            justify-content: center;
        }

        #now-playing {
            max-width: 60vw;
            text-align: left;
        }
    }
</style>

<style is:global>
    /* the YT API replaces this div with an iframe, losing the scoped attribute */
    #yt-player {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }
</style>

<script is:inline src="https://www.youtube.com/iframe_api"></script>
<script>
    const icons = {
        play: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>',
        pause: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zm7 0h3v14h-3z"/></svg>',
    };
    const btn = document.getElementById('song-btn') as HTMLButtonElement;
    const icon = document.getElementById('song-icon')!;
    const label = document.getElementById('now-playing')!;
    if (!btn.dataset.bound) {
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
            const w = window as any;
            if (!w.player) {
                w.player = new YT.Player('yt-player', {
                    videoId: 'xetCxo0bMxs',
                    playerVars: { playsinline: 1 },
                    events: {
                        onReady: () => (window as any).player!.playVideo(),
                        onStateChange: (e: YT.OnStateChangeEvent) => {
                            const player = (window as any).player as YT.Player;
                            const playing = e.data === YT.PlayerState.PLAYING;
                            icon.innerHTML = playing ? icons.pause : icons.play;
                            btn.classList.toggle('playing', playing);
                            if (playing) {
                                const d = player.getVideoData();
                                label.innerHTML = `now playing:<br><a href="https://youtu.be/xetCxo0bMxs" target="_blank" rel="noopener">${d.title}</a>`;
                            }
                            label.hidden = !playing;
                        },
                    },
                });
            } else {
                w.player.getPlayerState() === YT.PlayerState.PLAYING
                    ? w.player.pauseVideo()
                    : w.player.playVideo();
            }
        });
    }
</script>
