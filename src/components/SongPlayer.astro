<div class="player" transition:persist="song-player">
    <div class="song">
        <span id="now-playing"></span>
        <span id="play-hint" aria-hidden="true">play music<span class="arrows">&gt;&gt;</span></span>
        <div class="transport">
            <button id="prev-btn" aria-label="previous song"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5.5h2v13H6zm12 0v13l-8.5-6.5z"/></svg></button>
            <div class="pad">
            <button id="song-btn" aria-label="play song">
            <svg class="orbit" viewBox="0 0 100 100" fill="none" aria-hidden="true"><circle cx="50" cy="50" r="46" stroke="currentColor" stroke-width="3" stroke-dasharray="250 39" transform="rotate(118 50 50)"/></svg>
            <svg id="song-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>
        </button>
        </div>
        <button id="next-btn" aria-label="next song"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5.5h2v13h-2zM6 5.5v13l8.5-6.5z"/></svg></button>
        </div>
    </div>
    <audio id="audio" preload="none"></audio>
</div>

<style>
    .song {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .transport {
        display: flex;
        align-items: center;
    }

    .pad {
        position: relative;
        display: grid;
        place-items: center;
        width: 4em;
        aspect-ratio: 1;
    }

    #song-btn {
        position: relative;
        height: 3.2em;
        aspect-ratio: 1;
        border: none;
        background: none;
        color: inherit;
        cursor: pointer;
        padding: 0;
        display: grid;
        place-items: center;
    }

    #song-btn .orbit {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    #song-btn.playing .orbit {
        animation: spin 6s linear infinite;
    }

    @keyframes spin {
        to {
            transform: rotate(1turn);
        }
    }

    #next-btn,
    #prev-btn {
        display: grid;
        place-items: center;
        width: 2em;
        aspect-ratio: 1;
        border: 1px solid currentColor;
        border-radius: 50%;
        background: none;
        color: inherit;
        cursor: pointer;
        padding: 0;
        opacity: 0.6;
    }

    #next-btn svg,
    #prev-btn svg {
        width: 1.28em;
        height: 1.28em;
    }

    #next-btn:hover,
    #prev-btn:hover {
        opacity: 1;
    }

    #song-icon {
        display: block;
        width: 40%;
        height: 40%;
    }

    #play-hint {
        position: absolute;
        right: calc(100% + 0.5rem);
        top: 50%;
        translate: 0 -50%;
        display: inline-flex;
        gap: 0.3em;
        white-space: nowrap;
        opacity: 0.4;
        user-select: none;
    }

    #play-hint.hidden {
        display: none;
    }

    #now-playing {
        min-width: 0;
        max-width: 24rem;
        overflow: hidden;
        text-align: right;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.4s ease, translate 0.4s ease;
        translate: 0 0.4em;
    }

    #now-playing.show {
        opacity: 1;
        pointer-events: auto;
        translate: 0 0;
    }

    @media (max-width: 40rem) {
        .song {
            flex-direction: row-reverse;
            justify-content: center;
        }

        #play-hint {
            right: auto;
            left: calc(100% + 0.5rem);
            flex-direction: row-reverse;
        }

        #play-hint .arrows {
            transform: scaleX(-1);
        }

        #now-playing {
            max-width: 60vw;
            text-align: left;
        }
    }
</style>

<script>
    import catalog from '../music/catalog.json';

    interface Track {
        id: string;
        title: string;
        seconds: number;
        audioFile: string;
        bytes: number;
    }

    const icons = {
        play: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>',
        pause: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3v14H7zm7 0h3v14h-3z"/></svg>',
    };
    const audio = document.getElementById('audio') as HTMLAudioElement;
    const btn = document.getElementById('song-btn') as HTMLButtonElement;
    const icon = document.getElementById('song-icon')!;
    const label = document.getElementById('now-playing')!;
    const hint = document.getElementById('play-hint')!;

    const shuffleOrder = (tracks: Track[]): Track[] => {
        const out = [...tracks];
        for (let i = out.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [out[i], out[j]] = [out[j], out[i]];
        }
        return out;
    };

    const stepIndex = (current: number, direction: 1 | -1, length: number): number =>
        (current + direction + length) % length;

    const playTrack = (track: Track | undefined): void => {
        if (!track) return;
        audio.src = track.audioFile;
        audio.play();
    };

    if (!btn.dataset.bound) {
        btn.dataset.bound = '1';
        const queue = shuffleOrder(catalog.tracks as Track[]);
        let at = 0;

        audio.addEventListener('play', () => {
            const track = queue[at];
            icon.innerHTML = icons.pause;
            btn.classList.add('playing');
            label.innerHTML = `now playing:<br><a href="https://youtu.be/${track.id}" target="_blank" rel="noopener">${track.title}</a>`;
            label.classList.add('show');
            hint.classList.add('hidden');
        });

        audio.addEventListener('pause', () => {
            icon.innerHTML = icons.play;
            btn.classList.remove('playing');
            label.classList.remove('show');
        });

        audio.addEventListener('ended', () => {
            at = stepIndex(at, 1, queue.length);
            playTrack(queue[at]);
        });

        btn.addEventListener('click', () => {
            if (!audio.paused) {
                audio.pause();
            } else if (audio.src) {
                audio.play();
            } else {
                playTrack(queue[at]);
            }
        });
        document.getElementById('next-btn')?.addEventListener('click', () => {
            at = stepIndex(at, 1, queue.length);
            playTrack(queue[at]);
        });
        document.getElementById('prev-btn')?.addEventListener('click', () => {
            at = stepIndex(at, -1, queue.length);
            playTrack(queue[at]);
        });
    }
</script>
