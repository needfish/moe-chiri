---
const now = new Date();
const version = `${now.getFullYear()}.${String(now.getMonth() + 1).padStart(2, "0")}`;
---

<style>
    footer span {
        opacity: 0.55;
    }
</style>
<footer>
    <div class="separator">· · ✦ · ·</div>
    <div class="footer-content">
      <span>v{version}</span>
    </div>
</footer>
