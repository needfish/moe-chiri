---
const year = new Date().getFullYear();
const month = String(new Date().getMonth() + 1).padStart(2, "0");
---

<footer>
    <style>
        footer span {
            opacity: 0.55;
        }
    </style>
    <div class="separator">· · ✦ · ·</div>
    <div class="footer-content">
      <span>v{year}.{month}</span>
    </div>
</footer>
